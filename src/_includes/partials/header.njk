{# Site header: sticky, responsive, icons + labels + active indicator #}
<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="brand" href="https://www.geospatialannotation.com/" aria-label="Home — {{ siteTitle }}">
      <svg class="brand__logo" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="b1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#94d0e6"/>
            <stop offset="55%" stop-color="#43b7a5"/>
            <stop offset="100%" stop-color="#ffc73a"/>
          </linearGradient>
          <linearGradient id="b2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ff8e6d"/>
            <stop offset="100%" stop-color="#f06a48"/>
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="60" height="60" rx="13" fill="url(#b1)"/>
        <g fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="1.25" stroke-linecap="round">
          <path d="M8 44 C 18 36, 28 42, 38 34 S 56 26, 58 20"/>
          <path d="M8 50 C 20 44, 30 48, 42 40 S 56 32, 60 28"/>
          <path d="M8 38 C 16 32, 24 36, 32 30 S 48 20, 56 14"/>
        </g>
        <rect x="22" y="20" width="22" height="18" rx="2.5" fill="none" stroke="#ffd862" stroke-width="2" stroke-dasharray="3 2.5"/>
        <path d="M33 22 c -4.2 0 -7.5 3.3 -7.5 7.4 0 5.5 7.5 12 7.5 12 s 7.5 -6.5 7.5 -12 c 0 -4.1 -3.3 -7.4 -7.5 -7.4 z" fill="url(#b2)" stroke="#fff" stroke-width="1.4"/>
        <circle cx="33" cy="29.4" r="2.4" fill="#fff"/>
      </svg>
      <span class="brand__text">
        <span>GeoAnnotation</span>
        <span class="brand__sub">ML Pipeline Automation</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <a href="https://www.geospatialannotation.com/" class="{% if page.url == '/' %}is-active{% endif %}">
        <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 3l9 8"/><path d="M5 10v10h14V10"/></svg>
        <span class="site-nav__label">Home</span>
      </a>
      {% for section in navTree.children %}
      <a href="{{ siteUrl }}{{ section.url }}" class="{% if topSection == section.url %}is-active{% endif %}">
        {% if 'fundamentals' in section.url %}
          <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
        {% elif 'labeling' in section.url %}
          <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6"/><path d="M15 15l3 3 5-5"/><path d="M8 9h7M8 13h4"/></svg>
        {% elif 'versioning' in section.url %}
          <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6"/></svg>
        {% else %}
          <svg class="site-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
        {% endif %}
        <span class="site-nav__label">{{ section.title | replace(" for Geospatial AI/ML Pipelines", "") | replace("Active Learning & Model Feedback Loops for Geospatial Annotation", "Active Learning") | replace(" for Geospatial AI", "") | replace(" & Architecture", "") | replace("Labeling Workflows & Toolchain Integration", "Labeling Workflows") | replace("Dataset Versioning & Spatial Data Sync", "Dataset Versioning") | replace("Geospatial Annotation Fundamentals", "Fundamentals") }}</span>
      </a>
      {% endfor %}
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme" aria-pressed="false">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/></svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z"/></svg>
    </button>
  </div>
</header>
