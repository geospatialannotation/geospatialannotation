<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <div>
      <div class="site-footer__brand">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <linearGradient id="fb1" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#94d0e6"/>
              <stop offset="55%" stop-color="#43b7a5"/>
              <stop offset="100%" stop-color="#ffc73a"/>
            </linearGradient>
          </defs>
          <rect x="2" y="2" width="60" height="60" rx="13" fill="url(#fb1)"/>
          <rect x="22" y="20" width="22" height="18" rx="2.5" fill="none" stroke="#ffd862" stroke-width="2" stroke-dasharray="3 2.5"/>
          <path d="M33 22 c -4.2 0 -7.5 3.3 -7.5 7.4 0 5.5 7.5 12 7.5 12 s 7.5 -6.5 7.5 -12 c 0 -4.1 -3.3 -7.4 -7.5 -7.4 z" fill="#ff8e6d" stroke="#fff" stroke-width="1.4"/>
        </svg>
        <div>
          <div style="font-weight:700;color:var(--ink);">GeoAnnotation</div>
          <div style="font-size:.78rem;color:var(--muted);letter-spacing:.04em;text-transform:uppercase;">ML Pipeline Automation</div>
        </div>
      </div>
      <p>Engineering production-grade pipelines for spatial annotation, dataset versioning, and active learning at scale.</p>
    </div>

    {% for section in navTree.children %}
    <div>
      <h4>{{ section.title | replace(" for Geospatial AI/ML Pipelines", "") | replace("Active Learning & Model Feedback Loops for Geospatial Annotation", "Active Learning") | replace(" for Geospatial AI", "") | replace(" & Architecture", "") | replace("Labeling Workflows & Toolchain Integration", "Labeling") | replace("Dataset Versioning & Spatial Data Sync", "Versioning") | replace("Geospatial Annotation Fundamentals", "Fundamentals") }}</h4>
      <ul>
        <li><a href="{{ section.url }}">Overview</a></li>
        {% for child in section.children %}
          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>

  <div class="site-footer__bottom">
    <span>© {{ currentYear }} Geospatial Annotation & ML Pipeline Automation</span>
    <span>Built with care for spatial data teams.</span>
  </div>
</footer>
